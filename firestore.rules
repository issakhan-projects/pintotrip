rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUserRequiredFields() {
      return request.resource.data.keys().hasAll([
        'name',
        'lastname',
        'email',
        'country',
        'city',
        'aiCreditsBalance',
        'preferences',
        'subscription',
        'createdAt',
        'updatedAt'
      ]);
    }

    // Travel Intelligence contribution metadata is Admin SDK only.
    // Use affectedKeys (not value ==) so soft-deletes / status edits are not
    // denied by map or Timestamp equality quirks on unchanged fields.
    function preservesIntelligenceMetadata() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['intelligenceContribution', 'aggregatedAt']);
    }

    // users/{userId}
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Create or first merge-write of the profile document.
      allow create: if isOwner(userId)
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.lastname is string
        && request.resource.data.aiCreditsBalance == 100
        && hasUserRequiredFields()
        && request.resource.data.subscription.plan == 'free'
        && request.resource.data.subscription.status == 'active';

      // merge:true on a missing doc is create; on an existing doc is update.
      // Allow owners to complete an incomplete first write.
      allow update: if isOwner(userId)
        && request.resource.data.email == resource.data.email
        // Credits are mutated only by Cloud Functions (Admin SDK).
        && request.resource.data.aiCreditsBalance == resource.data.aiCreditsBalance
        // Review reward flag is mutated only by Cloud Functions.
        && request.resource.data.get('hasLeftReview', false)
          == resource.data.get('hasLeftReview', false)
        // Subscription / Paddle fields — Cloud Functions (webhooks) only.
        && request.resource.data.subscription == resource.data.subscription;

      allow delete: if isOwner(userId);

      // users/{userId}/locations/{locationId}
      match /locations/{locationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'title',
            'description',
            'lat',
            'lon',
            'country',
            'city',
            'status',
            'images',
            'confidence',
            'ai',
            'source',
            'createdAt',
            'updatedAt'
          ])
          && !('intelligenceContribution' in request.resource.data)
          && !('aggregatedAt' in request.resource.data)
          && request.resource.data.get('aggregated', false) == false;
        allow update: if isOwner(userId)
          && preservesIntelligenceMetadata();
        allow delete: if isOwner(userId);
      }

      // users/{userId}/favoriteCities/{cityId}
      match /favoriteCities/{cityId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'cityId',
            'cityName',
            'country',
            'lat',
            'lon',
            'status',
            'createdAt'
          ])
          && !('intelligenceContribution' in request.resource.data)
          && !('aggregatedAt' in request.resource.data)
          && request.resource.data.get('aggregated', false) == false;
        // Shape is enforced on create. Updates only need ownership + TI guards
        // (keys().hasAll blocked soft-delete of legacy docs missing createdAt).
        allow update: if isOwner(userId)
          && preservesIntelligenceMetadata();
        allow delete: if isOwner(userId);
      }

      // users/{userId}/tripPlanner/{tripId}
      match /tripPlanner/{tripId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasAll([
            'userId',
            'name',
            'from',
            'destinations',
            'startDate',
            'endDate',
            'status',
            'currency',
            'cityIntelligence',
            'preparation',
            'savedPlaceIds',
            'itinerary',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.destinations is list
          && request.resource.data.destinations.size() > 0;

        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userId == userId;

        allow delete: if isOwner(userId);

        // users/{userId}/tripPlanner/{tripId}/routes/{routeId}
        match /routes/{routeId} {
          allow read, create, update, delete: if isOwner(userId);
        }
      }

      // users/{userId}/notifications — inbox (owner read/mark-read; Admin create)
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // aiUsage/{yyyy-MM} — global AI cost totals (Cloud Functions / Admin only)
    match /aiUsage/{monthId} {
      allow read, write: if false;
    }

    // reviews/{userId} — in-app reviews (Cloud Functions / Admin write only)
    match /reviews/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // referrals/{referralId} — invite / referral ledger (Admin write only)
    match /referrals/{referralId} {
      allow read: if isSignedIn()
        && (resource.data.referrerId == request.auth.uid
          || resource.data.referredUserId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // referralClaims/{userId} — one invitee completion per user (Admin only)
    match /referralClaims/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // promoCodes/{code} — read-only for signed-in checkout validation UI.
    // Writes are Admin / Cloud Functions only.
    match /promoCodes/{codeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Internal AI result cache — Admin SDK only (never client-readable).
    match /aiCache/{fingerprint} {
      allow read, write: if false;
    }

    // Shared city airports / train stations — Admin SDK only.
    // Filled by onTripPlannerCreated to skip repeat Places Text Search.
    match /cityTransportCache/{cacheKey} {
      allow read, write: if false;
    }

    // Paddle webhook idempotency ledger — Admin SDK only.
    match /paddleWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // Billing transactions — owner read; Admin / Cloud Functions write only.
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Travel Intelligence — published aggregates (signed-in read, Admin write).
    // Nested as travelIntelligence/{bucket}/items/{docId}.
    match /travelIntelligence/{bucket}/items/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Internal unique-user link docs — Admin only (never client-readable).
    match /travelIntelligence/_meta/{document=**} {
      allow read, write: if false;
    }

    // Deny everything else by default (no allow read, write: if true).
  }
}
