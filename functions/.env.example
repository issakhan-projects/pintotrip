# =============================================================================
# Cloud Functions environment (non-secret params)
# =============================================================================
# Copy to `functions/.env` for emulator / deploy params.
#
# Secrets (set both sandbox + live — no swapping needed):
#   firebase functions:secrets:set PADDLE_API_KEY_SANDBOX
#   firebase functions:secrets:set PADDLE_API_KEY_LIVE
#   firebase functions:secrets:set PADDLE_NOTIFICATION_WEBHOOK_SECRET_SANDBOX
#   firebase functions:secrets:set PADDLE_NOTIFICATION_WEBHOOK_SECRET_LIVE
# =============================================================================

# Sandbox catalog (localhost checkouts)
PADDLE_PRICE_PLUS_MONTH_SANDBOX=
PADDLE_PRICE_PLUS_YEAR_SANDBOX=
PADDLE_PRICE_PRO_MONTH_SANDBOX=
PADDLE_PRICE_PRO_YEAR_SANDBOX=

# Live catalog (pintototrip.app / pintotrip.com)
PADDLE_PRICE_PLUS_MONTH_LIVE=
PADDLE_PRICE_PLUS_YEAR_LIVE=
PADDLE_PRICE_PRO_MONTH_LIVE=
PADDLE_PRICE_PRO_YEAR_LIVE=

# Optional product-level fallbacks (leave empty — price IDs are enough)
PADDLE_PRODUCT_PLUS=
PADDLE_PRODUCT_PRO=
