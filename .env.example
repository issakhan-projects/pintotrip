# =============================================================================
# PinToTrip — environment variables
# =============================================================================
# Copy this file to `.env.local` for local Next.js development.
# NEVER commit real secrets. NEVER put server secrets in NEXT_PUBLIC_* vars.
#
# Local development:  .env.local
# Production secrets: Google Cloud Secret Manager / Firebase Functions secrets
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC CLIENT CONFIG (safe for the browser via NEXT_PUBLIC_*)
# Used by: Next.js client, Firebase web SDK, Google Maps JS API, PostHog
# Place in: .env.local (local) and Firebase App Hosting env / build config (prod)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Browser Maps JavaScript API key (restrict by HTTP referrer in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# REQUIRED for city boundary highlights (Data-Driven Styling):
# Google Cloud Console → Map Management → create a JavaScript VECTOR Map ID
# → Map Style → Feature layers → enable:
#    - LOCALITY (cities in covered countries)
#    - ADMINISTRATIVE_AREA_LEVEL_1 (needed for Kazakhstan: Almaty / Astana)
# Note: Kazakhstan has Admin Area 1 coverage but NOT Locality.
# DEMO_MAP_ID (used when empty) supports Advanced Markers but NOT city boundaries.
# Also enable Places API (New), Geocoding API, and Time Zone API on the same
# project/key for city name → Place ID resolution and destination timezones.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_GOOGLE_MAPS_VERSION=weekly

# PostHog project API key (Settings → Project). Project ID is dashboard-only.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Paddle Billing (client — NEXT_PUBLIC_* only)
# Dashboard: https://vendors.paddle.com (live) / https://sandbox-vendors.paddle.com
# -----------------------------------------------------------------------------
# Keep BOTH tokens. Hostname picks which one to use:
#   localhost / 127.0.0.1 / *.vercel.app  → sandbox (test_…)
#   pintototrip.app / pintotrip.com       → live (live_…)
# Optional override: NEXT_PUBLIC_PADDLE_FORCE_ENVIRONMENT=sandbox|production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN_SANDBOX=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN_LIVE=
# NEXT_PUBLIC_PADDLE_FORCE_ENVIRONMENT=

# Price IDs (sandbox + live) live in src/features/pricing/tiers.ts
# After deploy: Checkout → Checkout settings → Default payment link
# (sandbox may use localhost; live must be an approved real domain).

# Google Search Console — HTML tag verification content value
# Search Console → Add property → HTML tag → copy content="..." only
# Also set in Firebase App Hosting env (BUILD + RUNTIME) for production.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: Cloud Functions region (client callables default to project region)
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# -----------------------------------------------------------------------------
# SERVER ONLY — NEVER use NEXT_PUBLIC_ for these
# Place in: Google Cloud Secret Manager / Firebase Functions secrets
# Local Functions emulator: use `firebase functions:secrets:set` or .secret.local
# Local Next.js API routes: .env.local (e.g. Pexels proxy under /api/pexels)
# -----------------------------------------------------------------------------

# Pexels — Next.js /api/pexels/photo only (City Intelligence hero images).
# Dashboard: https://www.pexels.com/api/ — NEVER NEXT_PUBLIC_*.
PEXELS_API_KEY=

# OpenAI — Cloud Functions (findPlace / getCityIntelligence / planTrip).
# Also used by local Next.js /api/trip-planner/fill-places for place-fill debug.
# NEVER NEXT_PUBLIC_*.
OPENAI_API_KEY=

# OpenWeatherMap — Cloud Functions only (getTripWeather). NEVER call from the browser.
OPENWEATHERMAP_API_KEY=

# Private Google server key for Places Nearby Search (onTripPlannerCreated).
# Restrict by IP / Places API (New) in Cloud Console. NEVER NEXT_PUBLIC_*.
GOOGLE_PRIVATE_API_KEY=

# Resend — Cloud Functions only (welcome email on users/{uid} create)
RESEND_API_KEY=

# Paddle Billing — SERVER ONLY (webhooks / customer portal). NEVER NEXT_PUBLIC_*.
# Keep BOTH sandbox + live keys; webhook/portal pick by signature / stored env.
# Paddle → Developer tools → Authentication → API key
PADDLE_API_KEY_SANDBOX=
PADDLE_API_KEY_LIVE=
# Paddle → Developer tools → Notifications → destination secrets (one per account)
PADDLE_NOTIFICATION_WEBHOOK_SECRET_SANDBOX=
PADDLE_NOTIFICATION_WEBHOOK_SECRET_LIVE=
# Catalog mapping for Cloud Functions: functions/.env (see functions/.env.example)

# Optional future authoritative providers (Functions / Secret Manager)
# EXCHANGE_RATE_API_KEY=
# VISA_INFO_API_KEY=

# =============================================================================
# NOTES
# =============================================================================
# - Firebase web config (NEXT_PUBLIC_FIREBASE_*) is required for Auth / Firestore.
# - NEXT_PUBLIC_GOOGLE_MAPS_API_KEY is required only when using maps features.
# - NEXT_PUBLIC_POSTHOG_KEY is optional; analytics is skipped when empty.
# - Firebase web config is designed to be public but must be protected with
#   Auth, Firestore, and Storage security rules.
# - OPENAI_API_KEY must be bound to Cloud Functions via:
#     firebase functions:secrets:set OPENAI_API_KEY
# - RESEND_API_KEY must be bound the same way:
#     firebase functions:secrets:set RESEND_API_KEY
# - OPENWEATHERMAP_API_KEY must be bound the same way:
#     firebase functions:secrets:set OPENWEATHERMAP_API_KEY
# - PEXELS_API_KEY goes in .env.local (and App Hosting env) for Next.js /api/pexels/photo.
#   Do not put it in NEXT_PUBLIC_* or Firebase Functions secrets unless you add a Functions caller.
# - GOOGLE_PRIVATE_API_KEY must be bound the same way (Places Nearby for transport):
#     firebase functions:secrets:set GOOGLE_PRIVATE_API_KEY
# - Paddle: set NEXT_PUBLIC_PADDLE_CLIENT_TOKEN_SANDBOX + _LIVE (hostname auto-picks).
#   Price IDs (sandbox + live) in src/features/pricing/tiers.ts.
#   Server secrets:
#     firebase functions:secrets:set PADDLE_API_KEY_SANDBOX
#     firebase functions:secrets:set PADDLE_API_KEY_LIVE
#     firebase functions:secrets:set PADDLE_NOTIFICATION_WEBHOOK_SECRET_SANDBOX
#     firebase functions:secrets:set PADDLE_NOTIFICATION_WEBHOOK_SECRET_LIVE
#   Catalog params: functions/.env (see functions/.env.example).
#   Webhook URL (both accounts): https://us-central1-<project>.cloudfunctions.net/paddleWebhook
# - Do not put service account JSON in the Next.js app or NEXT_PUBLIC_* vars.
# - In Firebase Console → Authentication → Sign-in method, enable Email/Password
#   (and Google if using Google sign-in). Add localhost under Authorized domains.
# =============================================================================
