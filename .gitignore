# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/functions/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/functions/lib

# misc
.DS_Store
*.pem
*.p12
service-account*.json
*-firebase-adminsdk*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firebase-debug.*.log
ui-debug.log

# env / secrets — never commit real credentials
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.secret.local
*.secret
!/.env.example

# vercel / hosting
.vercel
.firebase

# typescript
*.tsbuildinfo
next-env.d.ts
